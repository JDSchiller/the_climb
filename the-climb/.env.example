# Database: leave unset for a local SQLite file (data/app.db).
# On Vercel, the Turso marketplace integration sets these automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Clip/document storage: set automatically when a Vercel Blob store is connected.
# Leave unset locally to store uploads on disk (data/uploads).
BLOB_READ_WRITE_TOKEN=

# Show login codes on screen instead of sending email/SMS. Set false once a sender is wired up.
SANDBOX_MODE=true
